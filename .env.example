# بسطة — متغيرات البيئة (Auth + Store + Products + Orders + Payments)
# انسخي هذا الملف إلى .env.local وعبّيه بقيمك الحقيقية

# ── قاعدة البيانات (Supabase Postgres) ──────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true&connection_limit=1"

# ── Supabase Auth ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# ── Rate Limiting (Upstash Redis) ───────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── تشفير مفاتيح الدفع الخاصة بالتجار (lib/crypto.ts) ───
# توليد قيمة جديدة: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ لو تغيّر هذا المفتاح، كل مفاتيح Moyasar المحفوظة للتجار تصبح غير قابلة لفك التشفير
ENCRYPTION_KEY=""

# ── عام ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ملاحظة مهمة: لا يوجد مفتاح Moyasar مشترك للتجار هنا — كل تاجر يربط
# مفتاحه الخاص من لوحته (POST /api/stores/payment-gateway)، ويُخزَّن
# مشفّراً في StoreSubscription.merchantMoyasarSecretKeyEnc، وليس هنا.

# ── بوابة دفع المنصة (اشتراكات التجار الشهرية — منفصلة كلياً عن حسابات
# Moyasar الخاصة بكل تاجر أعلاه) ─────────────────────────────────────
# حساب Moyasar خاص ببسطة نفسها، يُحصِّل رسوم الاشتراك من التجار. نفس نمط
# Invoices API المُستضافة المستخدَم أصلاً لمدفوعات العملاء (لا حاجة لمفتاح
# علني client-side — لا نجمع بيانات بطاقة على صفحاتنا إطلاقاً).
PLATFORM_MOYASAR_SECRET_KEY=""
# سر الـ webhook الخاص بهذا الحساب (من إعدادات Webhook بلوحة Moyasar،
# مختلف تماماً عن merchantGatewayWebhookSecret الخاص بكل تاجر)
PLATFORM_MOYASAR_WEBHOOK_SECRET=""
# سر مشترك بسيط لحماية GET/POST /api/cron/subscription-lifecycle — يُستدعى
# من مجدول خارجي فقط، وليس من المتصفح إطلاقاً. مسارا تشغيل مدعومان معاً:
# 1) Vercel Cron (vercel.json بالجذر) — يحقن هذا السرّ تلقائياً كـ
#    "Authorization: Bearer <القيمة>" بمجرد ضبط هذا المتغيّر بنفس الاسم
#    بإعدادات مشروع Vercel (Settings → Environment Variables) — لا حاجة
#    لأي إعداد إضافي من جهتك.
# 2) أي scheduler خارجي آخر (GitHub Actions + curl، crontab + curl) —
#    أرسلي POST بترويسة: x-cron-secret: <نفس القيمة>
#    مثال: curl -X POST https://دومينك/api/cron/subscription-lifecycle \
#          -H "x-cron-secret: <القيمة>"
CRON_SECRET=""

# ── AI (منيرة) ───────────────────────────────────────────
ANTHROPIC_API_KEY=""           # claude-sonnet-4-20250514
OPENAI_API_KEY=""              # Whisper للتحويل الصوتي

# ── البريد الإلكتروني ─────────────────────────────────────
# RESEND_API_KEY=

# ── مزوّد شحن اختباري "بسطة للشحن" (mock — راجع app/api/test-shipping-provider) ──
# نفس القيمة تُدخَل كـapiKey عند إضافة الشركة بلوحة الأدمن
TEST_SHIPPING_PROVIDER_KEY="basita-test-key-change-me"

UPSTASH_REDIS_REST_URL="https://expert-oryx-107521.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAaQBAAIgcDExZmI1ZmJkYmM0ODE0MTY4OWMyZGFiMmQ2NGZiY2I2Zg"